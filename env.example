# Copy this file to .env and fill in the values:
#
#   cp env.example .env
#
# `docker compose` loads `.env` from this directory automatically. `.env` is
# git-ignored; this example file is not, so keep it free of real values.
#
# The alloy service declares both variables below with ${VAR:?Set VAR}, so
# compose refuses to start while either one is missing instead of shipping
# logs with no `vps` label.

# Identifies this VPS in every log stream (label: vps).
# Any short, unique, human-readable name works.
VPS_NAME=vps-1

# Full Loki push endpoint, including the /loki/api/v1/push path.
# - Loki in the same compose network:  http://loki:3100/loki/api/v1/push
# - Loki on another host:              http://loki.internal:3100/loki/api/v1/push
# - Loki behind TLS:                   https://loki.example.com/loki/api/v1/push
LOKI_PUSH_URL=http://loki.internal:3100/loki/api/v1/push

# --- Optional: only if your Loki requires basic auth -----------------------
# Uncomment both lines AND add LOKI_USER / LOKI_PASSWORD to the alloy
# service's `environment:` list in docker-compose.yml, plus the `basic_auth`
# block inside `endpoint {}` in files/config.alloy.
#
# LOKI_USER=alloy-push
# LOKI_PASSWORD=change-me

# --- Optional: node_exporter / cadvisor ------------------------------------
# Neither service reads environment variables. They publish host ports
# (9100 and 8080); restrict or rebind those in docker-compose.yml if needed.
