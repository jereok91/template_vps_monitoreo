# Copy this file to .env and fill in the values:
#
#   cp env.example .env
#
# `docker compose` loads `.env` from this directory automatically. `.env` is
# git-ignored; this example file is not, so keep it free of real values.
#
# The stack requires the isolated WireGuard client described in docs/vpn-dokploy.md:
# the exporters have no published ports, so Prometheus can only reach them through
# the peer tunnel address.

# Identifies this VPS in every log stream (label: vps).
# Any short, unique, human-readable name works: [A-Za-z0-9._-].
VPS_NAME=vps-1

# Full Loki push endpoint, including the /loki/api/v1/push path.
# It MUST be the central hub tunnel address, never a public URL:
# vpnctl validates that the host is covered by the client config's AllowedIPs and
# refuses to start otherwise, so logs cannot silently leave over public egress.
LOKI_PUSH_URL=http://10.77.0.1:3100/loki/api/v1/push

# --- Optional: only if your Loki requires basic auth -----------------------
# Uncomment both lines AND add LOKI_USER / LOKI_PASSWORD to the alloy
# service's `environment:` list in docker-compose.yml, plus the `basic_auth`
# block inside `endpoint {}` in files/config.alloy.
#
# LOKI_USER=alloy-push
# LOKI_PASSWORD=change-me

# --- WireGuard client inputs ----------------------------------------------
# Documented default: a read-only file mount of the config exported on the central
# VPS with `scripts/vpn/peer.sh show <name>`. In Dokploy that file is a File Mount
# (Advanced -> Mounts) written to <app>/files/wg0.conf and mounted at
# /config/wg0.conf by docker-compose.yml. Never commit a real wg0.conf:
# ./files/wg0.conf is git-ignored.
#
# Where the read-only mount of that file comes from:
#   local checkout (default): ./files/wg0.conf
#   Dokploy:                  ../files/wg0.conf  (the File Mount lives one level
#                             above the compose clone and survives redeploys)
# WG_CONFIG_PATH=../files/wg0.conf
#
# Do not set VPN_CONFIG_FILE in .env: the container path (/config/wg0.conf) is
# already correct, and setting it disables the base64 fallback as "ambiguous".

# Optional: set only when the client config's Endpoint is a DNS name and you want
# to skip the one resolution step at container start. Use the hub public IPv4.
# VPN_ENDPOINT_IP=203.0.113.10

# Optional: ports Prometheus scrapes through the tunnel. Keep these private.
# VPN_EXPORTER_PORTS=9100,8080

# Optional: connectivity threshold for `vpnctl verify` (seconds).
# VPN_HANDSHAKE_MAX_AGE=180

# Optional, NOT the documented default: base64 of the whole client config, decoded
# at startup into a 0600 file under /run/vpn (tmpfs). base64 is NOT encryption:
# `docker inspect`, the Dokploy UI and any local Docker administrator can read it.
# Use the file mount above instead. Never set both inputs.
# WG_CONFIG_BASE64=

# --- node_exporter / cadvisor ---------------------------------------------
# Neither service reads environment variables. They have no published ports:
# they are reachable only through the WireGuard tunnel from the central hub.
