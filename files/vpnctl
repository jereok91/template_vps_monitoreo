#!/bin/sh
#
# vpnctl - isolated WireGuard client for the VPS monitoring template.
#
# This runs inside the dedicated VPN container (client mode, BusyBox ash) and
# deliberately does NOT use wg-quick:
#
#   * wg-quick directives are rejected, so no hook ever runs;
#   * DNS is validated but ignored (no /etc/resolv.conf is touched);
#   * the interface, address, routes, traffic guard and readiness marker are
#     created explicitly from a validated, sanitized configuration;
#   * the default route is removed only after the WireGuard endpoint host route
#     is pinned, so monitoring traffic can never silently fall back to public
#     egress.
#
# Readiness and connectivity are different claims: `healthcheck` reports whether
# the interface, address, routes and guard are in place, while `verify` is the
# only subcommand that claims a (recent) handshake.
#
# Every error message names the field, directive or variable only. Private keys,
# preshared keys and any other configuration value are never written to stdout,
# stderr or a log file.
#
# Subcommands:
#   check-config   validate the configuration and print the resolved plan
#   up             build the tunnel, apply the guard, publish readiness, supervise
#   healthcheck    readiness only (Docker healthcheck)
#   status         readiness plus handshake age and transfer totals
#   verify         connectivity: a handshake exists and is recent enough
#   hostnet-loop   host NIC counters for node_exporter's textfile collector
#
# Usage: vpnctl [-h|--help] [check-config|up|healthcheck|status|verify|hostnet-loop]

set -u

VPNCTL_VERSION=1

# ---------------------------------------------------------------------------
# Environment (all values are validated before they reach ip/wg/iptables)
# ---------------------------------------------------------------------------
# Whether the operator pinned the config path explicitly (checked before defaulting,
# so the WG_CONFIG_BASE64 fallback is not mistaken for a second input).
CONFIG_FILE_EXPLICIT=0
if [ -n "${VPN_CONFIG_FILE+set}" ]; then
  CONFIG_FILE_EXPLICIT=1
fi
VPN_CONFIG_FILE="${VPN_CONFIG_FILE:-/config/wg0.conf}"
WG_CONFIG_BASE64="${WG_CONFIG_BASE64:-}"

VPN_RUN_DIR="${VPN_RUN_DIR:-/run/vpn}"
VPN_WG_IFACE="${VPN_WG_IFACE:-wg0}"
VPN_TEXTFILE_DIR="${VPN_TEXTFILE_DIR:-/var/lib/node_exporter/textfile}"
VPN_HOST_PROC="${VPN_HOST_PROC:-/host/proc}"
VPN_HOSTNET_INTERVAL="${VPN_HOSTNET_INTERVAL:-15}"
VPN_HOSTNET_ONCE="${VPN_HOSTNET_ONCE:-0}"
VPN_SUPERVISE_INTERVAL="${VPN_SUPERVISE_INTERVAL:-10}"
VPN_HANDSHAKE_MAX_AGE="${VPN_HANDSHAKE_MAX_AGE:-180}"

VPN_ALLOWED_IPV4_MIN_PREFIX="${VPN_ALLOWED_IPV4_MIN_PREFIX:-24}"
VPN_EXPORTER_PORTS="${VPN_EXPORTER_PORTS:-9100,8080}"
VPN_ENDPOINT_IP="${VPN_ENDPOINT_IP:-}"

VPS_NAME="${VPS_NAME:-}"
LOKI_PUSH_URL="${LOKI_PUSH_URL:-}"

# Absolute path to this script, used to spawn `hostnet-loop` in the background.
SELF=$0
case "$SELF" in
  "") SELF=vpnctl ;;
  */*) ;;
  *) SELF="./${SELF}" ;;
esac
SELF_SHELL="${VPNCTL_SHELL:-/bin/sh}"

READY_FILE="${VPN_RUN_DIR}/ready"
SETCONF_FILE="${VPN_RUN_DIR}/${VPN_WG_IFACE}.setconf"
DECODED_FILE=''

HOSTNET_PID=''
HOSTNET_SLEEP_PID=''
SUPERVISE_SLEEP_PID=''
DEFAULT_ROUTE_DELETED=0

# ---------------------------------------------------------------------------
# Messages
# ---------------------------------------------------------------------------
log() {
  printf 'vpnctl: %s\n' "$*" >&2
}

die() {
  die_code=$1
  shift
  printf 'vpnctl: %s\n' "$*" >&2
  exit "$die_code"
}

usage() {
  cat <<'USAGE'
vpnctl - isolated WireGuard client for the monitoring template

Usage: vpnctl [SUBCOMMAND]

Subcommands:
  check-config    Validate the client configuration and print the resolved plan.
                  Pure: no ip/wg/iptables call, no write outside VPN_RUN_DIR.
  up              Validate, create the interface, routes and traffic guard,
                  write the readiness marker, then supervise (default).
  healthcheck     Readiness only: marker, interface, address, hub route, guard.
                  Exit 0 when ready, 1 otherwise.
  status          Readiness plus hub/endpoint, handshake age and transfer totals.
  verify          Connectivity: exit 0 only for a recent handshake.
  hostnet-loop    Emit host NIC counters to the node_exporter textfile collector.
  -h, --help      Show this help.

Environment:
  VPN_CONFIG_FILE            client config (default /config/wg0.conf)
  WG_CONFIG_BASE64           base64 of the whole config (base64 is NOT encryption)
  VPN_RUN_DIR                runtime directory (default /run/vpn)
  VPN_WG_IFACE               tunnel interface (default wg0)
  VPN_TEXTFILE_DIR           textfile collector directory
                             (default /var/lib/node_exporter/textfile)
  VPN_HOST_PROC              host proc mount (default /host/proc)
  VPN_HOSTNET_INTERVAL       hostnet-loop period in seconds (default 15)
  VPN_HOSTNET_ONCE           emit once and exit (default 0)
  VPN_SUPERVISE_INTERVAL     supervisor period in seconds (default 10)
  VPN_HANDSHAKE_MAX_AGE      maximum handshake age for `verify` (default 180)
  VPN_ALLOWED_IPV4_MIN_PREFIX  most permissive allowed AllowedIPs prefix (default 24)
  VPN_EXPORTER_PORTS         comma-separated exporter ports (default 9100,8080)
  VPN_ENDPOINT_IP            explicit endpoint IPv4, skips hostname resolution
  VPS_NAME                   identity of this VPS (required by check-config/up)
  LOKI_PUSH_URL              Loki push URL over the tunnel (required, IPv4 host)

Notes:
  * Exactly one configuration input must be supplied: the mounted file or the
    base64 fallback. Supplying both is rejected as ambiguous.
  * wg-quick hooks (PreUp/PostUp/PreDown/PostDown), Table and SaveConfig are
    rejected: nothing is executed on the host and no route is taken implicitly.
  * DNS entries are validated and ignored inside the isolated namespace.
USAGE
}

# ---------------------------------------------------------------------------
# Value validation helpers. None of them prints or logs its input.
# ---------------------------------------------------------------------------
valid_key() {
  vk_key=$1
  [ "${#vk_key}" -eq 44 ] || return 1
  case "$vk_key" in
    *=) ;;
    *) return 1 ;;
  esac
  vk_body=${vk_key%=}
  case "$vk_body" in
    ''|*[!A-Za-z0-9+/]*) return 1 ;;
  esac
  return 0
}

valid_ipv4() {
  v4_ip=$1
  case "$v4_ip" in
    ''|*[!0-9.]*) return 1 ;;
    .*|*.|*..*) return 1 ;;
  esac
  v4_count=0
  v4_rest=$v4_ip
  while [ -n "$v4_rest" ]; do
    case "$v4_rest" in
      *.*) v4_oct=${v4_rest%%.*}; v4_rest=${v4_rest#*.} ;;
      *) v4_oct=$v4_rest; v4_rest='' ;;
    esac
    case "$v4_oct" in
      ''|*[!0-9]*) return 1 ;;
      0*[0-9]*) return 1 ;;
    esac
    [ "${#v4_oct}" -le 3 ] || return 1
    [ "$v4_oct" -le 255 ] || return 1
    v4_count=$((v4_count + 1))
  done
  [ "$v4_count" -eq 4 ] || return 1
  return 0
}

# Result is left in IP_INT (no subshell, no output).
ip_to_int() {
  i2i_rest=$1
  i2i_val=0
  i2i_idx=0
  while [ -n "$i2i_rest" ]; do
    case "$i2i_rest" in
      *.*) i2i_oct=${i2i_rest%%.*}; i2i_rest=${i2i_rest#*.} ;;
      *) i2i_oct=$i2i_rest; i2i_rest='' ;;
    esac
    case "$i2i_idx" in
      0) i2i_val=$((i2i_oct * 16777216)) ;;
      1) i2i_val=$((i2i_val + i2i_oct * 65536)) ;;
      2) i2i_val=$((i2i_val + i2i_oct * 256)) ;;
      *) i2i_val=$((i2i_val + i2i_oct)) ;;
    esac
    i2i_idx=$((i2i_idx + 1))
  done
  IP_INT=$i2i_val
}

# require_uint <value> <variable-name>: positive integer, no leading zero.
require_uint() {
  case "$1" in
    ''|*[!0-9]*|0*) die 2 "$2 must be a positive integer" ;;
  esac
  return 0
}

valid_prefix() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    0*[0-9]*) return 1 ;;
  esac
  [ "${#1}" -le 2 ] || return 1
  [ "$1" -le 32 ] || return 1
  return 0
}

valid_port() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    0*) return 1 ;;
  esac
  [ "${#1}" -le 5 ] || return 1
  [ "$1" -ge 1 ] || return 1
  [ "$1" -le 65535 ] || return 1
  return 0
}

valid_hostname() {
  case "$1" in
    ''|*[!A-Za-z0-9.-]*) return 1 ;;
  esac
  case "$1" in
    [A-Za-z0-9]|[A-Za-z0-9]*[A-Za-z0-9]) return 0 ;;
  esac
  return 1
}

# cidr_contains <cidr> <ipv4>
cidr_contains() {
  cc_cidr=$1
  cc_ip=$2
  case "$cc_cidr" in
    */*) ;;
    *) return 1 ;;
  esac
  cc_net=${cc_cidr%%/*}
  cc_pfx=${cc_cidr#*/}
  valid_ipv4 "$cc_net" || return 1
  valid_ipv4 "$cc_ip" || return 1
  valid_prefix "$cc_pfx" || return 1
  ip_to_int "$cc_net"
  cc_netint=$IP_INT
  ip_to_int "$cc_ip"
  cc_ipint=$IP_INT
  cc_mask=0
  cc_i=0
  while [ "$cc_i" -lt "$cc_pfx" ]; do
    cc_mask=$(((cc_mask >> 1) | 0x80000000))
    cc_i=$((cc_i + 1))
  done
  [ "$((cc_netint & cc_mask))" -eq "$((cc_ipint & cc_mask))" ] || return 1
  return 0
}

# join_csv <space separated words>
join_csv() {
  jc_out=''
  for jc_item in $1; do
    if [ -z "$jc_out" ]; then
      jc_out=$jc_item
    else
      jc_out="${jc_out},${jc_item}"
    fi
  done
  printf '%s' "$jc_out"
}

# ---------------------------------------------------------------------------
# Input resolution: exactly one of the mounted file or the base64 fallback.
# ---------------------------------------------------------------------------
decode_base64() {
  if command -v base64 >/dev/null 2>&1; then
    if base64 -d </dev/null >/dev/null 2>&1; then
      base64 -d
      return $?
    fi
    if base64 -D </dev/null >/dev/null 2>&1; then
      base64 -D
      return $?
    fi
  fi
  if command -v openssl >/dev/null 2>&1; then
    openssl base64 -d -A
    return $?
  fi
  printf 'vpnctl: no base64 decoder available (base64 or openssl)\n' >&2
  return 1
}

resolve_config() {
  CONF_SRC=''
  DECODED_CONFIG=0

  rs_has_b64=0
  [ -n "$WG_CONFIG_BASE64" ] && rs_has_b64=1

  if [ "$rs_has_b64" = 1 ]; then
    rs_conflict=0
    [ "$CONFIG_FILE_EXPLICIT" = 1 ] && rs_conflict=1
    [ -e "$VPN_CONFIG_FILE" ] && rs_conflict=1
    if [ "$rs_conflict" = 1 ]; then
      die 2 "ambiguous configuration input: set either VPN_CONFIG_FILE or WG_CONFIG_BASE64, not both"
    fi
    mkdir -p "$VPN_RUN_DIR" 2>/dev/null || die 2 "cannot create VPN_RUN_DIR=$VPN_RUN_DIR"
    rs_out="${VPN_RUN_DIR}/${VPN_WG_IFACE}.conf"
    (umask 077; printf '%s\n' "$WG_CONFIG_BASE64" | decode_base64 >"$rs_out") ||
      die 2 "WG_CONFIG_BASE64 could not be decoded (base64 is not encryption)"
    chmod 600 "$rs_out" 2>/dev/null || true
    [ -s "$rs_out" ] || die 2 "WG_CONFIG_BASE64 decoded to an empty configuration"
    CONF_SRC=$rs_out
    DECODED_CONFIG=1
    DECODED_FILE=$rs_out
    return 0
  fi

  if [ -d "$VPN_CONFIG_FILE" ]; then
    die 2 "configuration path is a directory, not a file: $VPN_CONFIG_FILE"
  fi
  if [ ! -f "$VPN_CONFIG_FILE" ]; then
    die 2 "configuration file not found: $VPN_CONFIG_FILE (mount the generated client config read-only, or provide WG_CONFIG_BASE64)"
  fi
  CONF_SRC=$VPN_CONFIG_FILE
  return 0
}

# ---------------------------------------------------------------------------
# Strict configuration parser. Reads stdin; stores values in V_* variables.
# ---------------------------------------------------------------------------
parse_config() {
  pc_lineno=0
  CUR_SECTION=''
  SEC_IFACE=0
  SEC_PEER=0

  H_PrivateKey=0; V_PrivateKey=''
  H_Address=0; V_Address=''
  H_ListenPort=0; V_ListenPort=''
  H_DNS=0; V_DNS=''
  H_MTU=0; V_MTU=''
  H_FwMark=0; V_FwMark=''
  H_PublicKey=0; V_PublicKey=''
  H_PresharedKey=0; V_PresharedKey=''
  H_AllowedIPs=0; V_AllowedIPs=''
  H_Endpoint=0; V_Endpoint=''
  H_PersistentKeepalive=0; V_PersistentKeepalive=''

  while IFS= read -r pc_raw || [ -n "$pc_raw" ]; do
    pc_lineno=$((pc_lineno + 1))
    pc_line=$(printf '%s' "$pc_raw" | tr -d '\r')
    pc_line=$(printf '%s' "$pc_line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$pc_line" ] || continue
    case "$pc_line" in
      '#'*|';'*) continue ;;
    esac

    # Section header?
    case "$pc_line" in
      '['*)
        case "$pc_line" in
          *']') ;;
          *) die 2 "malformed section header on line $pc_lineno" ;;
        esac
        pc_sec=${pc_line#\[}
        pc_sec=${pc_sec%\]}
        case "$pc_sec" in
          Interface)
            [ "$SEC_IFACE" = 1 ] && die 2 "duplicate [Interface] section"
            SEC_IFACE=1
            ;;
          Peer)
            [ "$SEC_PEER" = 1 ] && die 2 "duplicate [Peer] section"
            SEC_PEER=1
            ;;
          *) die 2 "unsupported section [$pc_sec]: only [Interface] and [Peer] are accepted" ;;
        esac
        CUR_SECTION=$pc_sec
        continue
        ;;
    esac

    case "$pc_line" in
      *=*) ;;
      *) die 2 "malformed line $pc_lineno: expected 'key = value'" ;;
    esac
    [ -n "$CUR_SECTION" ] ||
      die 2 "directive on line $pc_lineno appears before the [Interface] section"

    pc_key=${pc_line%%=*}
    pc_key=$(printf '%s' "$pc_key" | sed -e 's/[[:space:]]*$//')
    pc_val=${pc_line#*=}
    pc_val=$(printf '%s' "$pc_val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/[[:space:]]#.*$//')
    [ -n "$pc_key" ] || die 2 "malformed line $pc_lineno: expected 'key = value'"

    # wg-quick only directives: rejected by name, never executed, value never echoed.
    case "$pc_key" in
      PreUp|PostUp|PreDown|PostDown|Table|SaveConfig)
        die 2 "wg-quick directive $pc_key is not supported: vpnctl never runs hooks or takes routes implicitly"
        ;;
    esac

    if [ "$CUR_SECTION" = Interface ]; then
      case "$pc_key" in
        PrivateKey)
          [ "$H_PrivateKey" = 1 ] && die 2 "duplicate PrivateKey in [Interface]"
          H_PrivateKey=1; V_PrivateKey=$pc_val
          ;;
        Address)
          [ "$H_Address" = 1 ] && die 2 "duplicate Address in [Interface]"
          H_Address=1; V_Address=$pc_val
          ;;
        ListenPort)
          [ "$H_ListenPort" = 1 ] && die 2 "duplicate ListenPort in [Interface]"
          H_ListenPort=1; V_ListenPort=$pc_val
          ;;
        DNS)
          [ "$H_DNS" = 1 ] && die 2 "duplicate DNS in [Interface]"
          H_DNS=1; V_DNS=$pc_val
          ;;
        MTU)
          [ "$H_MTU" = 1 ] && die 2 "duplicate MTU in [Interface]"
          H_MTU=1; V_MTU=$pc_val
          ;;
        FwMark)
          [ "$H_FwMark" = 1 ] && die 2 "duplicate FwMark in [Interface]"
          H_FwMark=1; V_FwMark=$pc_val
          ;;
        PublicKey|PresharedKey|AllowedIPs|Endpoint|PersistentKeepalive)
          die 2 "directive $pc_key is not valid in [Interface]"
          ;;
        *) die 2 "unsupported directive $pc_key" ;;
      esac
    else
      case "$pc_key" in
        PublicKey)
          [ "$H_PublicKey" = 1 ] && die 2 "duplicate PublicKey in [Peer]"
          H_PublicKey=1; V_PublicKey=$pc_val
          ;;
        PresharedKey)
          [ "$H_PresharedKey" = 1 ] && die 2 "duplicate PresharedKey in [Peer]"
          H_PresharedKey=1; V_PresharedKey=$pc_val
          ;;
        AllowedIPs)
          [ "$H_AllowedIPs" = 1 ] && die 2 "duplicate AllowedIPs in [Peer]"
          H_AllowedIPs=1; V_AllowedIPs=$pc_val
          ;;
        Endpoint)
          [ "$H_Endpoint" = 1 ] && die 2 "duplicate Endpoint in [Peer]"
          H_Endpoint=1; V_Endpoint=$pc_val
          ;;
        PersistentKeepalive)
          [ "$H_PersistentKeepalive" = 1 ] && die 2 "duplicate PersistentKeepalive in [Peer]"
          H_PersistentKeepalive=1; V_PersistentKeepalive=$pc_val
          ;;
        PrivateKey|Address|ListenPort|DNS|MTU|FwMark)
          die 2 "directive $pc_key is not valid in [Peer]"
          ;;
        *) die 2 "unsupported directive $pc_key" ;;
      esac
    fi
  done

  [ "$SEC_IFACE" = 1 ] || die 2 "configuration is missing the [Interface] section"
  [ "$SEC_PEER" = 1 ] || die 2 "configuration is missing the [Peer] section"
  [ "$H_PrivateKey" = 1 ] || die 2 "configuration is missing PrivateKey in [Interface]"
  [ "$H_Address" = 1 ] || die 2 "configuration is missing Address in [Interface]"
  [ "$H_PublicKey" = 1 ] || die 2 "configuration is missing PublicKey in [Peer]"
  [ "$H_AllowedIPs" = 1 ] || die 2 "configuration is missing AllowedIPs in [Peer]"
  [ "$H_Endpoint" = 1 ] || die 2 "configuration is missing Endpoint in [Peer]"
  return 0
}

# ---------------------------------------------------------------------------
# Semantic validation. Fills the resolved plan variables.
# ---------------------------------------------------------------------------
parse_peer_address() {
  ppa_norm=$(printf '%s' "$1" | tr ',' ' ')
  ppa_count=0
  ppa_addr=''
  ppa_pfx=''
  for ppa_e in $ppa_norm; do
    ppa_count=$((ppa_count + 1))
    [ "$ppa_count" -le 1 ] || die 2 "Address must contain exactly one IPv4 address"
    ppa_item=$ppa_e
    case "$ppa_item" in
      *:*) die 2 "Address must be IPv4: IPv6 tunnel addresses are not supported" ;;
    esac
    case "$ppa_item" in
      */*) ppa_addr=${ppa_item%%/*}; ppa_pfx=${ppa_item#*/} ;;
      *) ppa_addr=$ppa_item; ppa_pfx=32 ;;
    esac
    valid_ipv4 "$ppa_addr" || die 2 "invalid Address: expected an IPv4 address (a.b.c.d[/prefix])"
    valid_prefix "$ppa_pfx" || die 2 "invalid Address prefix: expected 0-32"
  done
  [ "$ppa_count" -eq 1 ] || die 2 "Address must contain exactly one IPv4 address"
  PEER_ADDR=$ppa_addr
  PEER_PREFIX=$ppa_pfx
}

parse_allowed_ips() {
  pai_norm=$(printf '%s' "$1" | tr ',' ' ')
  ALLOWED_ROUTES=''
  pai_count=0
  for pai_e in $pai_norm; do
    case "$pai_e" in
      *:*) die 2 "AllowedIPs must be IPv4: IPv6 routes are not supported" ;;
    esac
    case "$pai_e" in
      */*) pai_net=${pai_e%%/*}; pai_pfx=${pai_e#*/} ;;
      *) die 2 "invalid AllowedIPs entry: expected a.b.c.d/n" ;;
    esac
    valid_ipv4 "$pai_net" || die 2 "invalid AllowedIPs entry: expected a.b.c.d/n"
    valid_prefix "$pai_pfx" || die 2 "invalid AllowedIPs prefix: expected 0-32"
    [ "$pai_pfx" = 0 ] &&
      die 2 "AllowedIPs must not contain the default route (0.0.0.0/0): monitoring traffic may not tunnel everything"
    if [ "$pai_pfx" -lt "$VPN_ALLOWED_IPV4_MIN_PREFIX" ]; then
      die 2 "AllowedIPs entry is broader than the allowed minimum /$VPN_ALLOWED_IPV4_MIN_PREFIX: keep routing scoped to the central monitoring address"
    fi
    case "$pai_net" in
      127.*) die 2 "AllowedIPs must not contain the loopback network" ;;
    esac
    ALLOWED_ROUTES="${ALLOWED_ROUTES} ${pai_net}/${pai_pfx}"
    pai_count=$((pai_count + 1))
  done
  [ "$pai_count" -ge 1 ] || die 2 "AllowedIPs must list at least one IPv4 CIDR"
  return 0
}

parse_loki_url() {
  pl_url=$LOKI_PUSH_URL
  case "$pl_url" in
    http://*) pl_rest=${pl_url#http://}; pl_default_port=80 ;;
    https://*) pl_rest=${pl_url#https://}; pl_default_port=443 ;;
    *) die 2 "LOKI_PUSH_URL must start with http:// or https://" ;;
  esac
  pl_authority=${pl_rest%%/*}
  [ -n "$pl_authority" ] || die 2 "LOKI_PUSH_URL has no host"
  case "$pl_authority" in
    '['*) die 2 "LOKI_PUSH_URL host must be an IPv4 literal: bracketed IPv6 is not supported" ;;
    *:*) pl_host=${pl_authority%%:*}; pl_port=${pl_authority#*:} ;;
    *) pl_host=$pl_authority; pl_port='' ;;
  esac
  case "$pl_host" in
    *:*|'') die 2 "LOKI_PUSH_URL host must be an IPv4 literal" ;;
  esac
  valid_ipv4 "$pl_host" || die 2 "LOKI_PUSH_URL host must be an IPv4 literal: exporters and Loki are reached through the tunnel by address"
  if [ -n "$pl_port" ]; then
    valid_port "$pl_port" || die 2 "LOKI_PUSH_URL port must be 1-65535"
  else
    pl_port=$pl_default_port
  fi
  HUB_IP=$pl_host
  LOKI_PORT=$pl_port
  return 0
}

parse_endpoint() {
  pe_ep=$1
  case "$pe_ep" in
    '['*) die 2 "Endpoint must not be IPv6: only IPv4 endpoints and DNS hostnames are supported" ;;
  esac
  case "$pe_ep" in
    *:*) pe_host=${pe_ep%:*}; pe_port=${pe_ep##*:} ;;
    *) die 2 "invalid Endpoint: expected host:port" ;;
  esac
  case "$pe_host" in
    *:*) die 2 "Endpoint must not be IPv6: only IPv4 endpoints and DNS hostnames are supported" ;;
  esac
  valid_port "$pe_port" || die 2 "invalid Endpoint port: expected 1-65535"
  if valid_ipv4 "$pe_host"; then
    ENDPOINT_IS_IP=1
  else
    ENDPOINT_IS_IP=0
    valid_hostname "$pe_host" ||
      die 2 "invalid Endpoint host: expected an IPv4 literal or a DNS hostname"
  fi
  ENDPOINT_HOST=$pe_host
  ENDPOINT_PORT=$pe_port
}

validate_exporter_ports() {
  case "$VPN_EXPORTER_PORTS" in
    '') die 2 "VPN_EXPORTER_PORTS must list 1-8 ports" ;;
    *' '*) die 2 "VPN_EXPORTER_PORTS must not contain spaces" ;;
    ,*|*,|*,,*) die 2 "VPN_EXPORTER_PORTS must list 1-8 comma-separated ports" ;;
  esac
  vep_norm=$(printf '%s' "$VPN_EXPORTER_PORTS" | tr ',' ' ')
  vep_count=0
  for vep_port in $vep_norm; do
    valid_port "$vep_port" || die 2 "invalid port in VPN_EXPORTER_PORTS (expected 1-65535)"
    vep_count=$((vep_count + 1))
  done
  if [ "$vep_count" -lt 1 ] || [ "$vep_count" -gt 8 ]; then
    die 2 "VPN_EXPORTER_PORTS must list 1-8 comma-separated ports"
  fi
  return 0
}

validate_config() {
  # Runtime identity.
  case "$VPS_NAME" in
    '') die 2 "VPS_NAME is required" ;;
    *[!A-Za-z0-9._-]*) die 2 "VPS_NAME must match [A-Za-z0-9._-]+" ;;
  esac
  [ -n "$LOKI_PUSH_URL" ] || die 2 "LOKI_PUSH_URL is required"

  require_uint "$VPN_SUPERVISE_INTERVAL" VPN_SUPERVISE_INTERVAL
  require_uint "$VPN_HOSTNET_INTERVAL" VPN_HOSTNET_INTERVAL
  require_uint "$VPN_HANDSHAKE_MAX_AGE" VPN_HANDSHAKE_MAX_AGE
  valid_prefix "$VPN_ALLOWED_IPV4_MIN_PREFIX" ||
    die 2 "VPN_ALLOWED_IPV4_MIN_PREFIX must be 0-32"
  validate_exporter_ports
  parse_loki_url

  # Keys: 44-character base64 shape (32 bytes). Values are never echoed.
  valid_key "$V_PrivateKey" ||
    die 2 "invalid PrivateKey: expected a 44-character base64 key"
  valid_key "$V_PublicKey" ||
    die 2 "invalid PublicKey: expected a 44-character base64 key"
  if [ "$H_PresharedKey" = 1 ]; then
    valid_key "$V_PresharedKey" ||
      die 2 "invalid PresharedKey: expected a 44-character base64 key"
  fi

  if [ "$H_ListenPort" = 1 ]; then
    valid_port "$V_ListenPort" || die 2 "invalid ListenPort: expected 1-65535"
    LISTEN_PORT=$V_ListenPort
  else
    LISTEN_PORT=''
  fi

  if [ "$H_MTU" = 1 ]; then
    case "$V_MTU" in
      ''|*[!0-9]*) die 2 "invalid MTU: expected a byte count" ;;
    esac
    [ "${#V_MTU}" -le 5 ] || die 2 "invalid MTU: expected a byte count"
    [ "$V_MTU" -ge 68 ] && [ "$V_MTU" -le 65535 ] ||
      die 2 "invalid MTU: expected 68-65535"
    MTU=$V_MTU
  else
    MTU=1420
  fi

  if [ "$H_FwMark" = 1 ]; then
    case "$V_FwMark" in
      ''|*[!0-9a-fA-Fx]*) die 2 "invalid FwMark: expected a numeric mark" ;;
    esac
    FWMARK=$V_FwMark
  else
    FWMARK=''
  fi

  if [ "$H_PersistentKeepalive" = 1 ]; then
    case "$V_PersistentKeepalive" in
      ''|*[!0-9]*) die 2 "invalid PersistentKeepalive: expected seconds (0-65535)" ;;
    esac
    [ "${#V_PersistentKeepalive}" -le 5 ] ||
      die 2 "invalid PersistentKeepalive: expected seconds (0-65535)"
    [ "$V_PersistentKeepalive" -le 65535 ] ||
      die 2 "invalid PersistentKeepalive: expected seconds (0-65535)"
    KEEPALIVE=$V_PersistentKeepalive
  else
    KEEPALIVE=''
  fi

  parse_peer_address "$V_Address"
  parse_allowed_ips "$V_AllowedIPs"
  ALLOWED_CSV=$(join_csv "$ALLOWED_ROUTES")

  # The Loki push host must be reachable through the tunnel.
  vc_covered=0
  for vc_route in $ALLOWED_ROUTES; do
    if cidr_contains "$vc_route" "$HUB_IP"; then
      vc_covered=1
      break
    fi
  done
  [ "$vc_covered" = 1 ] ||
    die 2 "loki push host $HUB_IP is not covered by AllowedIPs ($ALLOWED_CSV): monitoring traffic would leave the tunnel"

  parse_endpoint "$V_Endpoint"

  if [ -n "$VPN_ENDPOINT_IP" ]; then
    valid_ipv4 "$VPN_ENDPOINT_IP" ||
      die 2 "VPN_ENDPOINT_IP must be an IPv4 address"
    if [ "$ENDPOINT_IS_IP" = 1 ] && [ "$VPN_ENDPOINT_IP" != "$ENDPOINT_HOST" ]; then
      die 2 "ambiguous endpoint: VPN_ENDPOINT_IP differs from the IPv4 Endpoint in the configuration"
    fi
  fi

  # DNS is validated for shape only: it is never applied inside the namespace.
  DNS_CSV=''
  if [ "$H_DNS" = 1 ]; then
    vc_dns_norm=$(printf '%s' "$V_DNS" | tr ',' ' ')
    for vc_dns in $vc_dns_norm; do
      case "$vc_dns" in
        ''|*[!A-Za-z0-9:._-]*) die 2 "invalid DNS entry: expected an IP-like token" ;;
      esac
    done
    DNS_CSV=$(join_csv "$vc_dns_norm")
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
print_summary() {
  printf 'vpnctl %s: configuration ok\n' "$VPNCTL_VERSION"
  printf '  interface: %s\n' "$VPN_WG_IFACE"
  printf '  peer address: %s/32 (supplied %s/%s)\n' "$PEER_ADDR" "$PEER_ADDR" "$PEER_PREFIX"
  printf '  hub (loki) address: %s\n' "$HUB_IP"
  printf '  loki push: %s (tcp/%s)\n' "$LOKI_PUSH_URL" "$LOKI_PORT"
  printf '  exporter ports: %s\n' "$VPN_EXPORTER_PORTS"
  if [ -n "$VPN_ENDPOINT_IP" ]; then
    printf '  endpoint: %s:%s (VPN_ENDPOINT_IP override)\n' "$VPN_ENDPOINT_IP" "$ENDPOINT_PORT"
  elif [ "$ENDPOINT_IS_IP" = 1 ]; then
    printf '  endpoint: %s:%s\n' "$ENDPOINT_HOST" "$ENDPOINT_PORT"
  else
    printf '  endpoint: %s:%s (resolve at startup)\n' "$ENDPOINT_HOST" "$ENDPOINT_PORT"
  fi
  if [ -n "$KEEPALIVE" ]; then
    printf '  persistent keepalive: %s\n' "$KEEPALIVE"
  fi
  printf '  allowed routes: %s\n' "$ALLOWED_CSV"
  if [ -n "$DNS_CSV" ]; then
    printf '  dns: %s (ignored: no resolver inside the isolated namespace)\n' "$DNS_CSV"
  fi
}

# ---------------------------------------------------------------------------
# Traffic guard. Only the built-in filter chains of this namespace are used.
# ---------------------------------------------------------------------------
guard_policies_drop() {
  for gpd_chain in INPUT OUTPUT FORWARD; do
    gpd_line=$(iptables -S "$gpd_chain" 2>/dev/null | awk 'NR == 1 { print; exit }')
    [ "$gpd_line" = "-P $gpd_chain DROP" ] || return 1
  done
  return 0
}

# The tunnel is IPv4-only. When the namespace has IPv6, it is locked down
# completely: a namespace that happens to get an IPv6 address must not become a
# public egress path that bypasses the IPv4 guard. Hosts with IPv6 disabled
# (a common VPS hardening) have nothing to lock down and must still start.
namespace_has_ipv6() {
  case "${VPN_NAMESPACE_IPV6:-auto}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ -r /proc/net/if_inet6 ] || return 1
  grep -q . /proc/net/if_inet6 2>/dev/null
}

guard_ipv6_drop() {
  namespace_has_ipv6 || return 0
  command -v ip6tables >/dev/null 2>&1 || return 1
  ip6tables -F INPUT 2>/dev/null || return 1
  ip6tables -F OUTPUT 2>/dev/null || return 1
  ip6tables -F FORWARD 2>/dev/null || return 1
  ip6tables -P INPUT DROP 2>/dev/null || return 1
  ip6tables -P OUTPUT DROP 2>/dev/null || return 1
  ip6tables -P FORWARD DROP 2>/dev/null || return 1
  ip6tables -A INPUT -i lo -j ACCEPT 2>/dev/null || return 1
  ip6tables -A OUTPUT -o lo -j ACCEPT 2>/dev/null || return 1
  return 0
}

guard_ipv6_verify() {
  namespace_has_ipv6 || return 0
  command -v ip6tables >/dev/null 2>&1 || return 1
  for gv_chain in INPUT OUTPUT FORWARD; do
    gv_line=$(ip6tables -S "$gv_chain" 2>/dev/null | awk 'NR == 1 { print; exit }')
    [ "$gv_line" = "-P $gv_chain DROP" ] || return 1
  done
  ip6tables -C INPUT -i lo -j ACCEPT 2>/dev/null || return 1
  ip6tables -C OUTPUT -o lo -j ACCEPT 2>/dev/null || return 1
  return 0
}

# A failed start in the same namespace can leave DROP policies without the full
# allow set, which would block the endpoint resolution this start depends on.
guard_reset() {
  guard_ipv6_drop >/dev/null 2>&1 || true
  for gr_chain in INPUT OUTPUT FORWARD; do
    iptables -F "$gr_chain" 2>/dev/null || true
    iptables -P "$gr_chain" ACCEPT 2>/dev/null || true
  done
  return 0
}

guard_apply() {
  iptables -F INPUT 2>/dev/null || return 1
  iptables -F OUTPUT 2>/dev/null || return 1
  iptables -F FORWARD 2>/dev/null || return 1
  iptables -P INPUT DROP 2>/dev/null || return 1
  iptables -P OUTPUT DROP 2>/dev/null || return 1
  iptables -P FORWARD DROP 2>/dev/null || return 1
  iptables -A INPUT -i lo -j ACCEPT 2>/dev/null || return 1
  iptables -A OUTPUT -o lo -j ACCEPT 2>/dev/null || return 1
  iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || return 1
  iptables -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || return 1
  iptables -A OUTPUT -o "$VPN_WG_IFACE" -d "$HUB_IP" -p tcp --dport "$LOKI_PORT" -j ACCEPT 2>/dev/null || return 1
  iptables -A OUTPUT -o "$VPN_WG_IFACE" -d "$HUB_IP" -p icmp --icmp-type echo-request -j ACCEPT 2>/dev/null || return 1
  iptables -A INPUT -i "$VPN_WG_IFACE" -s "$HUB_IP" -p tcp -m multiport --dports "$VPN_EXPORTER_PORTS" -j ACCEPT 2>/dev/null || return 1
  iptables -A INPUT -i "$VPN_WG_IFACE" -s "$HUB_IP" -p icmp --icmp-type echo-request -j ACCEPT 2>/dev/null || return 1
  iptables -A OUTPUT -o "$EGRESS_IF" -d "$ENDPOINT_IP" -p udp --dport "$ENDPOINT_PORT" -j ACCEPT 2>/dev/null || return 1
  iptables -A INPUT -i "$EGRESS_IF" -s "$ENDPOINT_IP" -p udp -j ACCEPT 2>/dev/null || return 1
  guard_ipv6_drop || return 1
  return 0
}

# Verifies the complete guard (both families, every allow rule). The healthcheck
# passes the values frozen in the readiness marker, so it checks the live guard
# against what was published, not against a config file that may have changed.
guard_verify_for() { # iface hub loki_port ports egress endpoint_ip endpoint_port
  gvf_iface=$1
  gvf_hub=$2
  gvf_lport=$3
  gvf_ports=$4
  gvf_egress=$5
  gvf_eip=$6
  gvf_eport=$7
  guard_policies_drop || return 1
  guard_ipv6_verify || return 1
  iptables -C INPUT -i lo -j ACCEPT 2>/dev/null || return 1
  iptables -C OUTPUT -o lo -j ACCEPT 2>/dev/null || return 1
  iptables -C INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || return 1
  iptables -C OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || return 1
  iptables -C OUTPUT -o "$gvf_iface" -d "$gvf_hub" -p tcp --dport "$gvf_lport" -j ACCEPT 2>/dev/null || return 1
  iptables -C OUTPUT -o "$gvf_iface" -d "$gvf_hub" -p icmp --icmp-type echo-request -j ACCEPT 2>/dev/null || return 1
  iptables -C INPUT -i "$gvf_iface" -s "$gvf_hub" -p tcp -m multiport --dports "$gvf_ports" -j ACCEPT 2>/dev/null || return 1
  iptables -C INPUT -i "$gvf_iface" -s "$gvf_hub" -p icmp --icmp-type echo-request -j ACCEPT 2>/dev/null || return 1
  iptables -C OUTPUT -o "$gvf_egress" -d "$gvf_eip" -p udp --dport "$gvf_eport" -j ACCEPT 2>/dev/null || return 1
  iptables -C INPUT -i "$gvf_egress" -s "$gvf_eip" -p udp -j ACCEPT 2>/dev/null || return 1
  return 0
}

guard_verify() {
  guard_verify_for "$VPN_WG_IFACE" "$HUB_IP" "$LOKI_PORT" "$VPN_EXPORTER_PORTS" \
    "$EGRESS_IF" "$ENDPOINT_IP" "$ENDPOINT_PORT"
}

# ---------------------------------------------------------------------------
# Sanitized wg setconf input: interface address/DNS/MTU never reach `wg`.
# ---------------------------------------------------------------------------
write_setconf() {
  ws_endpoint=$1
  (umask 077; {
    printf '[Interface]\n'
    printf 'PrivateKey = %s\n' "$V_PrivateKey"
    if [ -n "$LISTEN_PORT" ]; then
      printf 'ListenPort = %s\n' "$LISTEN_PORT"
    fi
    if [ -n "$FWMARK" ]; then
      printf 'FwMark = %s\n' "$FWMARK"
    fi
    printf '\n[Peer]\n'
    printf 'PublicKey = %s\n' "$V_PublicKey"
    if [ -n "$V_PresharedKey" ]; then
      printf 'PresharedKey = %s\n' "$V_PresharedKey"
    fi
    printf 'AllowedIPs = %s\n' "$ALLOWED_CSV"
    printf 'Endpoint = %s\n' "$ws_endpoint"
    if [ -n "$KEEPALIVE" ]; then
      printf 'PersistentKeepalive = %s\n' "$KEEPALIVE"
    fi
  } >"$SETCONF_FILE") || return 1
  chmod 600 "$SETCONF_FILE" 2>/dev/null || true
  return 0
}

# ---------------------------------------------------------------------------
# Readiness marker
# ---------------------------------------------------------------------------
write_ready() {
  wr_tmp="${READY_FILE}.$$"
  (umask 077; {
    printf 'version=%s\n' "$VPNCTL_VERSION"
    printf 'iface=%s\n' "$VPN_WG_IFACE"
    printf 'addr=%s/32\n' "$PEER_ADDR"
    printf 'hub=%s\n' "$HUB_IP"
    printf 'loki_port=%s\n' "$LOKI_PORT"
    printf 'exporter_ports=%s\n' "$VPN_EXPORTER_PORTS"
    printf 'endpoint_ip=%s\n' "$ENDPOINT_IP"
    printf 'endpoint_port=%s\n' "$ENDPOINT_PORT"
    printf 'egress_if=%s\n' "$EGRESS_IF"
    printf 'gateway=%s\n' "$GW"
    printf 'mtu=%s\n' "$MTU"
    printf 'allowed_ips=%s\n' "$ALLOWED_CSV"
    printf 'keepalive=%s\n' "${KEEPALIVE:-0}"
    if namespace_has_ipv6; then
      printf 'ipv6=locked\n'
    else
      printf 'ipv6=absent\n'
    fi
    printf 'written_at=%s\n' "$(date +%s)"
  } >"$wr_tmp") || return 1
  chmod 600 "$wr_tmp" 2>/dev/null || true
  mv -f "$wr_tmp" "$READY_FILE" || return 1
  return 0
}

marker_value() {
  [ -f "$READY_FILE" ] || return 0
  awk -v key="$1" 'index($0, key "=") == 1 { sub(/^[^=]*=/, ""); print; exit }' "$READY_FILE"
}

# ---------------------------------------------------------------------------
# Handshake helpers (never print key material)
# ---------------------------------------------------------------------------
handshake_epoch() {
  he_val=$(wg show "$VPN_WG_IFACE" latest-handshakes 2>/dev/null | awk 'NR == 1 { print $2 }')
  case "$he_val" in
    ''|*[!0-9]*) printf '0' ;;
    *) printf '%s' "$he_val" ;;
  esac
}

# ---------------------------------------------------------------------------
# hostnet-loop: host NIC counters for node_exporter's textfile collector
# ---------------------------------------------------------------------------
emit_hostnet() {
  eh_src="${VPN_HOST_PROC}/1/net/dev"
  eh_dir=$VPN_TEXTFILE_DIR
  mkdir -p "$eh_dir" 2>/dev/null || return 1
  chmod 755 "$eh_dir" 2>/dev/null || true
  eh_tmp="${eh_dir}/.hostnet.prom.$$"
  eh_now=$(date +%s)
  eh_avail=0
  if [ -f "$eh_src" ] && [ -r "$eh_src" ]; then
    eh_avail=1
  fi
  (umask 022; {
    printf '# HELP hostnet_metrics_available 1 when host NIC counters were read from the host network namespace.\n'
    printf '# TYPE hostnet_metrics_available gauge\n'
    printf 'hostnet_metrics_available %s\n' "$eh_avail"
    printf '# HELP hostnet_last_read_timestamp_seconds Unix time of the last host NIC read attempt.\n'
    printf '# TYPE hostnet_last_read_timestamp_seconds gauge\n'
    printf 'hostnet_last_read_timestamp_seconds %s\n' "$eh_now"
    if [ "$eh_avail" = 1 ]; then
      awk '
        BEGIN {
          names_n = split("node_network_receive_bytes_total node_network_receive_packets_total node_network_receive_errs_total node_network_receive_drop_total node_network_receive_fifo_total node_network_receive_frame_total node_network_receive_compressed_total node_network_receive_multicast_total node_network_transmit_bytes_total node_network_transmit_packets_total node_network_transmit_errs_total node_network_transmit_drop_total node_network_transmit_fifo_total node_network_transmit_colls_total node_network_transmit_carrier_total node_network_transmit_compressed_total", names, " ")
          devcount = 0
        }
        {
          parts_n = split($0, parts, ":")
          if (parts_n < 2) next
          dev = parts[1]
          for (i = 2; i < parts_n; i++) dev = dev ":" parts[i]
          gsub(/^[ \t]+/, "", dev)
          gsub(/[ \t]+$/, "", dev)
          if (dev !~ /^[A-Za-z0-9_.:-]+$/) next
          vals_n = split(parts[parts_n], raw, /[ \t]+/)
          count = 0
          ok = 1
          for (i = 1; i <= vals_n; i++) {
            if (raw[i] == "") continue
            if (raw[i] !~ /^[0-9]+$/) { ok = 0; break }
            count++
            vals[count] = raw[i]
          }
          if (!ok || count != 16) next
          devcount++
          devs[devcount] = dev
          for (i = 1; i <= 16; i++) data[dev, i] = vals[i]
        }
        END {
          for (k = 1; k <= 16; k++) {
            printed = 0
            for (j = 1; j <= devcount; j++) {
              if (data[devs[j], k] == "") continue
              if (!printed) {
                print "# HELP " names[k] " Host NIC counter read from /proc/1/net/dev of the host network namespace."
                print "# TYPE " names[k] " counter"
                printed = 1
              }
              printf "%s{device=\"%s\",source=\"hostnet\"} %s\n", names[k], devs[j], data[devs[j], k]
            }
          }
        }
      ' "$eh_src" 2>/dev/null
    fi
  } >"$eh_tmp") || {
    rm -f "$eh_tmp" 2>/dev/null
    return 1
  }
  chmod 644 "$eh_tmp" 2>/dev/null || true
  mv -f "$eh_tmp" "${eh_dir}/hostnet.prom" || {
    rm -f "$eh_tmp" 2>/dev/null
    return 1
  }
  return 0
}

cmd_hostnet_loop() {
  case "$VPN_HOSTNET_INTERVAL" in
    ''|*[!0-9]*|0*) die 2 "VPN_HOSTNET_INTERVAL must be a positive integer" ;;
  esac
  # A backgrounded sleep keeps the loop responsive to TERM and leaves no child behind.
  trap 'kill ${HOSTNET_SLEEP_PID:-} 2>/dev/null; exit 0' TERM INT
  while :; do
    emit_hostnet || log "cannot write ${VPN_TEXTFILE_DIR}/hostnet.prom"
    if [ "$VPN_HOSTNET_ONCE" = 1 ]; then
      exit 0
    fi
    sleep "$VPN_HOSTNET_INTERVAL" &
    HOSTNET_SLEEP_PID=$!
    wait "$HOSTNET_SLEEP_PID" 2>/dev/null || true
    HOSTNET_SLEEP_PID=''
  done
}

# ---------------------------------------------------------------------------
# check-config
# ---------------------------------------------------------------------------
cmd_check_config() {
  resolve_config
  parse_config <"$CONF_SRC"
  validate_config
  print_summary
  exit 0
}

# ---------------------------------------------------------------------------
# up
# ---------------------------------------------------------------------------
stop_hostnet() {
  if [ -n "$HOSTNET_PID" ]; then
    kill "$HOSTNET_PID" 2>/dev/null || true
    HOSTNET_PID=''
  fi
}

stop_sleep() {
  if [ -n "$SUPERVISE_SLEEP_PID" ]; then
    kill "$SUPERVISE_SLEEP_PID" 2>/dev/null || true
    SUPERVISE_SLEEP_PID=''
  fi
}

spawn_hostnet() {
  VPN_HOSTNET_ONCE=0 "$SELF_SHELL" "$SELF" hostnet-loop &
  HOSTNET_PID=$!
}

cleanup_files() {
  stop_sleep
  stop_hostnet
  rm -f "$READY_FILE" "$SETCONF_FILE" 2>/dev/null || true
  if [ -n "$DECODED_FILE" ]; then
    rm -f "$DECODED_FILE" 2>/dev/null || true
  fi
}

# Closes the namespace when startup fails before the guard is in place: a reset
# guard is open until guard_apply rebuilds it.
close_guard_on_failure() {
  iptables -P INPUT DROP 2>/dev/null || true
  iptables -P OUTPUT DROP 2>/dev/null || true
  iptables -P FORWARD DROP 2>/dev/null || true
  guard_ipv6_drop >/dev/null 2>&1 || true
}

restore_default_route() {
  if [ "${DEFAULT_ROUTE_DELETED}" = 1 ] && [ -n "${GW:-}" ] && [ -n "${EGRESS_IF:-}" ]; then
    if ip route replace default via "$GW" dev "$EGRESS_IF" >/dev/null 2>&1; then
      DEFAULT_ROUTE_DELETED=0
    else
      log "could not restore the default route; the traffic guard still blocks egress"
    fi
  fi
  return 0
}

runtime_fail() {
  log "$1"
  close_guard_on_failure
  restore_default_route
  cleanup_files
  exit 1
}

cmd_up() {
  resolve_config
  parse_config <"$CONF_SRC"
  validate_config

  umask 077
  mkdir -p "$VPN_RUN_DIR" 2>/dev/null ||
    die 1 "cannot create the runtime directory $VPN_RUN_DIR"
  chmod 700 "$VPN_RUN_DIR" 2>/dev/null || true

  print_summary
  # From here on any failure removes the runtime files (and any decoded copy).
  trap 'restore_default_route; cleanup_files; exit 0' TERM INT

  # A previous failed start in this namespace may have left a half-built guard
  # (DROP policies without the allow set); reset it before endpoint resolution.
  guard_reset

  # 2. Egress discovery.
  up_default_route=$(ip route show default 2>/dev/null | awk 'NR == 1 { print; exit }')
  if [ -z "$up_default_route" ]; then
    runtime_fail "no default route in this network namespace: the WireGuard endpoint is unreachable"
  fi
  GW=$(printf '%s\n' "$up_default_route" |
    awk '{ for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }')
  EGRESS_IF=$(printf '%s\n' "$up_default_route" |
    awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
  valid_ipv4 "$GW" ||
    runtime_fail "cannot determine the default gateway from 'ip route show default'"
  case "$EGRESS_IF" in
    ''|*[!A-Za-z0-9_.:@-]*)
      runtime_fail "cannot determine the egress interface from 'ip route show default'"
      ;;
  esac

  # 3. Recreate the interface (idempotent re-run).
  if ip link show dev "$VPN_WG_IFACE" >/dev/null 2>&1; then
    ip link del dev "$VPN_WG_IFACE" >/dev/null 2>&1 ||
      runtime_fail "cannot remove the existing $VPN_WG_IFACE interface"
  fi
  ip link add dev "$VPN_WG_IFACE" type wireguard >/dev/null 2>&1 ||
    runtime_fail "cannot create $VPN_WG_IFACE: the wireguard kernel module must be loaded and NET_ADMIN granted"

  # 4. Sanitized wg configuration.
  if [ -n "$VPN_ENDPOINT_IP" ]; then
    up_endpoint="${VPN_ENDPOINT_IP}:${ENDPOINT_PORT}"
  else
    up_endpoint="${ENDPOINT_HOST}:${ENDPOINT_PORT}"
  fi
  write_setconf "$up_endpoint" ||
    runtime_fail "cannot write the sanitized configuration to $SETCONF_FILE"
  wg setconf "$VPN_WG_IFACE" "$SETCONF_FILE" >/dev/null 2>&1 ||
    runtime_fail "wg setconf rejected the sanitized configuration for $VPN_WG_IFACE"

  # 5. Read the endpoint back from wg (hostname resolution happened there).
  up_ep=$(wg show "$VPN_WG_IFACE" endpoints 2>/dev/null | awk 'NR == 1 { print $2 }')
  if [ -z "$up_ep" ]; then
    runtime_fail "wg reported no endpoint for $VPN_WG_IFACE: an endpoint hostname may be unresolvable here, set VPN_ENDPOINT_IP to the hub public IPv4 address"
  fi
  ENDPOINT_IP=${up_ep%:*}
  up_port=${up_ep##*:}
  case "$ENDPOINT_IP" in
    '['*|*:*) ENDPOINT_IP='' ;;
  esac
  if [ -z "$ENDPOINT_IP" ] || ! valid_ipv4 "$ENDPOINT_IP" || ! valid_port "$up_port"; then
    runtime_fail "cannot parse the endpoint wg resolved for $VPN_WG_IFACE, set VPN_ENDPOINT_IP to the hub public IPv4 address"
  fi
  ENDPOINT_PORT=$up_port
  if [ -n "$VPN_ENDPOINT_IP" ]; then
    ENDPOINT_IP=$VPN_ENDPOINT_IP
  fi

  # 6. Address, MTU, link state.
  ip addr add "$PEER_ADDR/32" dev "$VPN_WG_IFACE" >/dev/null 2>&1 ||
    runtime_fail "cannot assign $PEER_ADDR/32 to $VPN_WG_IFACE"
  ip link set dev "$VPN_WG_IFACE" mtu "$MTU" >/dev/null 2>&1 ||
    runtime_fail "cannot set MTU $MTU on $VPN_WG_IFACE"
  ip link set dev "$VPN_WG_IFACE" up >/dev/null 2>&1 ||
    runtime_fail "cannot bring $VPN_WG_IFACE up"

  # 7. Only the AllowedIPs routes: the peer address is a /32 host route.
  for up_route in $ALLOWED_ROUTES; do
    ip route replace "$up_route" dev "$VPN_WG_IFACE" >/dev/null 2>&1 ||
      runtime_fail "cannot route $up_route through $VPN_WG_IFACE"
  done

  # 8. Guard before readiness.
  guard_apply ||
    runtime_fail "cannot install the traffic guard (iptables and NET_ADMIN are required)"
  guard_verify ||
    runtime_fail "the traffic guard did not verify after applying it: refusing to report readiness"

  # 9. Lock the egress: endpoint host route first, then drop the default route.
  ip route replace "$ENDPOINT_IP/32" via "$GW" dev "$EGRESS_IF" >/dev/null 2>&1 ||
    runtime_fail "cannot pin the endpoint $ENDPOINT_IP to $EGRESS_IF"
  ip route del default >/dev/null 2>&1 ||
    runtime_fail "cannot remove the default route: public egress could silently carry monitoring traffic"
  DEFAULT_ROUTE_DELETED=1
  if [ -n "$(ip route show default 2>/dev/null)" ]; then
    runtime_fail "a default route is still present after lockdown: refusing the public fallback"
  fi

  # 10. Readiness marker last, atomically.
  write_ready || runtime_fail "cannot write the readiness marker $READY_FILE"
  log "ready: $VPN_WG_IFACE $PEER_ADDR/32 via $ENDPOINT_IP:$ENDPOINT_PORT ($EGRESS_IF/$GW)"

  # 11. Host metrics loop in the background, supervisor in the foreground.
  spawn_hostnet
  while :; do
    sleep "$VPN_SUPERVISE_INTERVAL" &
    SUPERVISE_SLEEP_PID=$!
    wait "$SUPERVISE_SLEEP_PID" 2>/dev/null || true
    SUPERVISE_SLEEP_PID=''
    if ! ip link show dev "$VPN_WG_IFACE" >/dev/null 2>&1; then
      runtime_fail "$VPN_WG_IFACE disappeared: exiting so the container restarts"
    fi
    if ! guard_verify; then
      log "the traffic guard drifted: re-applying"
      if ! guard_apply || ! guard_verify; then
        runtime_fail "cannot re-apply the traffic guard: exiting"
      fi
    fi
    if [ -n "$HOSTNET_PID" ] && ! kill -0 "$HOSTNET_PID" 2>/dev/null; then
      log "hostnet-loop exited: restarting it"
      HOSTNET_PID=''
      spawn_hostnet
    fi
  done
}

# ---------------------------------------------------------------------------
# healthcheck (readiness only, never a handshake)
# ---------------------------------------------------------------------------
cmd_healthcheck() {
  # The Docker healthcheck output is only visible in the health log, which makes
  # an unhealthy deploy opaque. Mirror the first occurrence of each reason into
  # the container log (PID 1's stderr) so `docker compose logs vpn` explains it.
  hc_no() {
    printf 'not ready: %s\n' "$1"
    hc_log_target=${VPN_HEALTH_LOG:-/proc/1/fd/2}
    hc_prev=''
    [ -f "${VPN_RUN_DIR}/health.reason" ] && hc_prev=$(cat "${VPN_RUN_DIR}/health.reason" 2>/dev/null)
    if [ "$hc_prev" != "$1" ]; then
      printf '%s\n' "$1" >"${VPN_RUN_DIR}/health.reason" 2>/dev/null || true
      printf 'vpnctl: not ready: %s\n' "$1" >>"$hc_log_target" 2>/dev/null || true
    fi
    exit 1
  }
  [ -f "$READY_FILE" ] || hc_no "no readiness marker at $READY_FILE"

  hc_iface=$(marker_value iface)
  hc_addr=$(marker_value addr)
  hc_hub=$(marker_value hub)
  hc_lport=$(marker_value loki_port)
  hc_ports=$(marker_value exporter_ports)
  hc_eip=$(marker_value endpoint_ip)
  hc_eport=$(marker_value endpoint_port)
  hc_egress=$(marker_value egress_if)

  case "$hc_iface" in
    ''|*[!A-Za-z0-9_.:@-]*) hc_no "readiness marker has no usable interface" ;;
  esac
  valid_ipv4 "$hc_hub" || hc_no "readiness marker has no usable hub address"
  valid_port "$hc_lport" || hc_no "readiness marker has no usable loki port"
  case "$hc_addr" in
    *' '*) hc_no "readiness marker has no usable address" ;;
  esac
  case "$hc_addr" in
    */32) ;;
    *) hc_no "readiness marker has no usable address" ;;
  esac
  case "$hc_ports" in
    ''|*' '*|*[!0-9,]*) hc_no "readiness marker has no usable exporter ports" ;;
  esac
  valid_ipv4 "$hc_eip" || hc_no "readiness marker has no usable endpoint address"
  valid_port "$hc_eport" || hc_no "readiness marker has no usable endpoint port"
  case "$hc_egress" in
    ''|*[!A-Za-z0-9_.:@-]*) hc_no "readiness marker has no usable egress interface" ;;
  esac

  ip link show dev "$hc_iface" >/dev/null 2>&1 || hc_no "$hc_iface does not exist"
  ip addr show dev "$hc_iface" 2>/dev/null | grep -F "$hc_addr" >/dev/null 2>&1 ||
    hc_no "$hc_addr is not assigned to $hc_iface"
  ip route show dev "$hc_iface" 2>/dev/null | grep -F "$hc_hub" >/dev/null 2>&1 ||
    hc_no "no route to $hc_hub through $hc_iface"
  guard_verify_for "$hc_iface" "$hc_hub" "$hc_lport" "$hc_ports" \
    "$hc_egress" "$hc_eip" "$hc_eport" ||
    hc_no "the traffic guard is incomplete (policies or an allow rule are missing)"

  rm -f "${VPN_RUN_DIR}/health.reason" 2>/dev/null || true
  printf 'ready: %s %s via %s\n' "$hc_iface" "$hc_addr" "$hc_hub"
  exit 0
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
cmd_status() {
  st_ready=0
  if [ -f "$READY_FILE" ]; then
    st_ready=1
  fi
  if [ "$st_ready" = 1 ]; then
    printf 'readiness: ready (%s)\n' "$READY_FILE"
  else
    printf 'readiness: not ready (no %s)\n' "$READY_FILE"
  fi
  st_iface=$(marker_value iface)
  [ -n "$st_iface" ] || st_iface=$VPN_WG_IFACE
  st_hub=$(marker_value hub)
  st_eip=$(marker_value endpoint_ip)
  st_eport=$(marker_value endpoint_port)
  printf 'hub: %s\n' "${st_hub:-unknown}"
  printf 'endpoint: %s:%s\n' "${st_eip:-unknown}" "${st_eport:-unknown}"

  st_now=$(date +%s)
  st_hs=$(handshake_epoch)
  if [ "$st_hs" -le 0 ]; then
    printf 'handshake: never\n'
  else
    printf 'handshake age: %ss\n' "$((st_now - st_hs))"
  fi
  st_rx=$(wg show "$VPN_WG_IFACE" transfer 2>/dev/null | awk 'NR == 1 { print $2 }')
  st_tx=$(wg show "$VPN_WG_IFACE" transfer 2>/dev/null | awk 'NR == 1 { print $3 }')
  case "$st_rx" in ''|*[!0-9]*) st_rx=0 ;; esac
  case "$st_tx" in ''|*[!0-9]*) st_tx=0 ;; esac
  printf 'transfer: rx=%s tx=%s\n' "$st_rx" "$st_tx"

  [ "$st_ready" = 1 ] && exit 0
  exit 1
}

# ---------------------------------------------------------------------------
# verify (the only connectivity claim)
# ---------------------------------------------------------------------------
cmd_verify() {
  case "$VPN_HANDSHAKE_MAX_AGE" in
    ''|*[!0-9]*|0*) die 2 "VPN_HANDSHAKE_MAX_AGE must be a positive integer" ;;
  esac
  vf_now=$(date +%s)
  vf_hs=$(handshake_epoch)
  if [ "$vf_hs" -le 0 ]; then
    printf 'connectivity: no handshake with the hub yet (never)\n'
    exit 1
  fi
  vf_age=$((vf_now - vf_hs))
  if [ "$vf_age" -gt "$VPN_HANDSHAKE_MAX_AGE" ]; then
    printf 'connectivity: handshake is stale (%ss old, max %ss)\n' "$vf_age" "$VPN_HANDSHAKE_MAX_AGE"
    exit 1
  fi
  printf 'connectivity: handshake ok (%ss old)\n' "$vf_age"
  exit 0
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
cmd=${1:-up}
if [ "$#" -gt 0 ]; then
  shift
fi
if [ "$#" -gt 0 ]; then
  usage >&2
  exit 2
fi

case "$cmd" in
  check-config) cmd_check_config ;;
  up) cmd_up ;;
  healthcheck) cmd_healthcheck ;;
  status) cmd_status ;;
  verify) cmd_verify ;;
  hostnet-loop) cmd_hostnet_loop ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
